<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FocusGuard — Daily Digest {{ date }}</title>
  <script src="chart.min.js"></script>
  <style>
    /* ── Reset & base ─────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                   "Helvetica Neue", Arial, sans-serif;
      background: #0f1117;
      color: #e2e8f0;
      min-height: 100vh;
      padding: 24px 16px 48px;
    }

    a { color: #63b3ed; text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── Layout ───────────────────────────────────────────────── */
    .page { max-width: 960px; margin: 0 auto; }

    /* ── Header ───────────────────────────────────────────────── */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
      padding-bottom: 16px;
      border-bottom: 1px solid #2d3748;
    }
    .header-left h1 {
      font-size: 1.6rem;
      font-weight: 700;
      color: #fff;
    }
    .header-left .date-label {
      font-size: 0.9rem;
      color: #718096;
      margin-top: 2px;
    }
    .logo {
      width: 40px; height: 40px;
      background: #38a169;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; font-weight: 700; color: #fff;
    }

    /* ── Stat cards ───────────────────────────────────────────── */
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
      margin-bottom: 32px;
    }
    .card {
      background: #1a202c;
      border: 1px solid #2d3748;
      border-radius: 10px;
      padding: 20px 16px;
    }
    .card .label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #718096;
      margin-bottom: 8px;
    }
    .card .value {
      font-size: 2rem;
      font-weight: 700;
      line-height: 1;
    }
    .card .sub {
      font-size: 0.8rem;
      color: #718096;
      margin-top: 4px;
    }
    .card.confirmed .value { color: #fc8181; }
    .card.unconfirmed .value { color: #f6ad55; }
    .card.total .value { color: #63b3ed; }
    .card.sessions .value { color: #68d391; }

    /* ── Section headings ─────────────────────────────────────── */
    .section { margin-bottom: 36px; }
    .section-title {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #718096;
      margin-bottom: 14px;
      padding-bottom: 6px;
      border-bottom: 1px solid #2d3748;
    }

    /* ── Charts ───────────────────────────────────────────────── */
    .chart-wrap {
      background: #1a202c;
      border: 1px solid #2d3748;
      border-radius: 10px;
      padding: 20px;
    }
    .chart-wrap canvas { max-height: 240px; }

    .charts-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    @media (max-width: 640px) { .charts-row { grid-template-columns: 1fr; } }

    /* ── Top sites ────────────────────────────────────────────── */
    .site-list { list-style: none; }
    .site-list li {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      background: #1a202c;
      border: 1px solid #2d3748;
      border-radius: 8px;
      margin-bottom: 8px;
    }
    .site-name { font-size: 0.95rem; }
    .site-bar-wrap {
      flex: 1; margin: 0 16px;
      height: 6px; background: #2d3748; border-radius: 3px; overflow: hidden;
    }
    .site-bar { height: 100%; background: #fc8181; border-radius: 3px; }
    .site-time { font-size: 0.8rem; color: #718096; white-space: nowrap; }

    /* ── Session table ────────────────────────────────────────── */
    .table-wrap {
      overflow-x: auto;
      background: #1a202c;
      border: 1px solid #2d3748;
      border-radius: 10px;
    }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    thead th {
      padding: 12px 16px;
      text-align: left;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #718096;
      border-bottom: 1px solid #2d3748;
    }
    tbody tr { border-bottom: 1px solid #2d3748; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #2d3748; }
    tbody td { padding: 11px 16px; }

    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 9999px;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .badge-confirmed   { background: #742a2a; color: #fc8181; }
    .badge-unconfirmed { background: #7b341e; color: #f6ad55; }
    .badge-looking     { background: #1c4532; color: #68d391; }
    .badge-not-looking { background: #2d3748; color: #a0aec0; }

    /* ── Empty state ──────────────────────────────────────────── */
    .empty {
      text-align: center;
      padding: 48px 16px;
      color: #4a5568;
    }
    .empty .icon { font-size: 2.5rem; margin-bottom: 12px; }
    .empty p { font-size: 0.95rem; }

    /* ── Footer ───────────────────────────────────────────────── */
    footer {
      margin-top: 48px;
      padding-top: 16px;
      border-top: 1px solid #2d3748;
      font-size: 0.78rem;
      color: #4a5568;
      text-align: center;
    }
  </style>
</head>

<body>
<div class="page">

  <!-- Header -->
  <header class="header">
    <div class="header-left">
      <h1>FocusGuard Daily Digest</h1>
      <div class="date-label">{{ date }}</div>
    </div>
    <div class="logo">FG</div>
  </header>

  <!-- Stat cards -->
  <div class="cards">
    <div class="card confirmed">
      <div class="label">Confirmed Doomscrolls</div>
      <div class="value">{{ confirmed_count }}</div>
      <div class="sub">{{ confirmed_duration_mins }} min total</div>
    </div>
    <div class="card unconfirmed">
      <div class="label">Unconfirmed Sessions</div>
      <div class="value">{{ unconfirmed_count }}</div>
      <div class="sub">{{ unconfirmed_duration_mins }} min total</div>
    </div>
    <div class="card total">
      <div class="label">Total Distraction</div>
      <div class="value">{{ (confirmed_duration_mins + unconfirmed_duration_mins) | round(1) }}</div>
      <div class="sub">minutes today</div>
    </div>
    <div class="card sessions">
      <div class="label">All Sessions</div>
      <div class="value">{{ confirmed_count + unconfirmed_count }}</div>
      <div class="sub">logged today</div>
    </div>
  </div>

  <!-- Charts row -->
  <div class="section">
    <div class="section-title">Distraction Patterns</div>
    <div class="charts-row">

      <!-- Hourly heatmap -->
      <div class="chart-wrap">
        <canvas id="hourlyChart"></canvas>
      </div>

      <!-- Weekly trend -->
      <div class="chart-wrap">
        <canvas id="weeklyChart"></canvas>
      </div>

    </div>
  </div>

  <!-- Top sites -->
  {% if top_sites %}
  <div class="section">
    <div class="section-title">Top Distracting Sites</div>
    {% set max_mins = top_sites[0].duration_mins if top_sites else 1 %}
    <ul class="site-list">
      {% for s in top_sites %}
      <li>
        <span class="site-name">{{ s.site }}</span>
        <div class="site-bar-wrap">
          <div class="site-bar"
               style="width: {{ ((s.duration_mins / max_mins) * 100) | round }}%"></div>
        </div>
        <span class="site-time">{{ s.duration_mins }} min</span>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <!-- Session log -->
  <div class="section">
    <div class="section-title">Session Log</div>
    {% if sessions %}
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Time</th>
            <th>Site / App</th>
            <th>Duration</th>
            <th>Tier</th>
            <th>Gaze</th>
          </tr>
        </thead>
        <tbody>
          {% for s in sessions %}
          <tr>
            <td>{{ s.time }}</td>
            <td>{{ s.site }}</td>
            <td>{{ s.duration_mins }} min</td>
            <td>
              {% if s.tier == "confirmed" %}
                <span class="badge badge-confirmed">Confirmed</span>
              {% else %}
                <span class="badge badge-unconfirmed">Unconfirmed</span>
              {% endif %}
            </td>
            <td>
              {% if s.gaze_status == "LOOKING" %}
                <span class="badge badge-looking">Looking</span>
              {% else %}
                <span class="badge badge-not-looking">{{ s.gaze_status | replace("_", " ") | title }}</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="empty">
      <div class="icon">🎉</div>
      <p>No doomscrolling sessions logged today.</p>
    </div>
    {% endif %}
  </div>

  <footer>
    Generated by FocusGuard &nbsp;•&nbsp; All data is stored locally on your machine
  </footer>

</div>

<!-- Chart.js initialisation -->
<script>
  const CHART_DEFAULTS = {
    color: "#a0aec0",
    borderColor: "#2d3748",
  };
  Chart.defaults.color = CHART_DEFAULTS.color;
  Chart.defaults.borderColor = CHART_DEFAULTS.borderColor;

  // ── Hourly heatmap bar chart ─────────────────────────────────
  const hourlyData = {{ hourly_buckets | tojson }};
  const hourLabels = Array.from({length: 24}, (_, i) => {
    const h = i % 12 || 12;
    return `${h}${i < 12 ? "am" : "pm"}`;
  });

  new Chart(document.getElementById("hourlyChart"), {
    type: "bar",
    data: {
      labels: hourLabels,
      datasets: [{
        label: "Confirmed (min)",
        data: hourlyData,
        backgroundColor: "#fc8181cc",
        borderColor: "#fc8181",
        borderWidth: 1,
        borderRadius: 3,
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false },
        title: {
          display: true,
          text: "Doomscrolling by Hour",
          color: "#e2e8f0",
          font: { size: 13 },
          padding: { bottom: 12 },
        }
      },
      scales: {
        x: { grid: { color: "#2d374880" }, ticks: { font: { size: 10 } } },
        y: {
          grid: { color: "#2d374880" },
          title: { display: true, text: "minutes", color: "#718096" },
          beginAtZero: true,
        }
      }
    }
  });

  // ── Weekly trend line chart ──────────────────────────────────
  const weeklyRaw  = {{ weekly_trend | tojson }};
  const weekLabels = weeklyRaw.map(d => d.date.slice(5));   // MM-DD
  const weekData   = weeklyRaw.map(d => d.confirmed_duration_mins);

  new Chart(document.getElementById("weeklyChart"), {
    type: "line",
    data: {
      labels: weekLabels,
      datasets: [{
        label: "Confirmed (min)",
        data: weekData,
        borderColor: "#63b3ed",
        backgroundColor: "#63b3ed22",
        tension: 0.35,
        fill: true,
        pointBackgroundColor: "#63b3ed",
        pointRadius: 4,
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false },
        title: {
          display: true,
          text: "7-Day Trend",
          color: "#e2e8f0",
          font: { size: 13 },
          padding: { bottom: 12 },
        }
      },
      scales: {
        x: { grid: { color: "#2d374880" } },
        y: {
          grid: { color: "#2d374880" },
          title: { display: true, text: "minutes", color: "#718096" },
          beginAtZero: true,
        }
      }
    }
  });
</script>

</body>
</html>
