<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FocusGuard Daily Digest — {{ date }}</title>
  
  <!-- Premium Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Offline-Capable Chart.js Asset -->
  <script src="chart.min.js"></script>

  <style>
    /* ----------------------------------------------------------------------
       Premium Dark-Mode Glassmorphism Design System
       ---------------------------------------------------------------------- */
    :root {
      --bg-gradient: linear-gradient(135deg, #0b0f19 0%, #111827 100%);
      --glass-bg: rgba(17, 24, 39, 0.7);
      --glass-border: rgba(255, 255, 255, 0.06);
      --glass-glow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
      
      --color-primary: hsl(142, 70%, 45%);     /* vibrant green */
      --color-accent: hsl(210, 100%, 50%);     /* bright sky blue */
      --color-warning: hsl(35, 100%, 55%);     /* amber orange */
      --color-danger: hsl(350, 85%, 55%);      /* glowing distraction red */
      
      --text-main: #f3f4f6;
      --text-muted: #9ca3af;
      --text-glow: 0 0 12px rgba(255, 255, 255, 0.1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg-gradient);
      color: var(--text-main);
      min-height: 100vh;
      padding: 2rem 1.5rem;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    /* ----------------------------------------------------------------------
       Header & Branding
       ---------------------------------------------------------------------- */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2.5rem;
      padding: 1.5rem;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: var(--glass-glow);
    }

    .branding {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-mark {
      width: 32px;
      height: 32px;
      background: radial-gradient(circle, var(--color-primary) 0%, #2e7d32 100%);
      border-radius: 50%;
      box-shadow: 0 0 15px rgba(76, 175, 80, 0.4);
    }

    .branding h1 {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.5px;
      background: linear-gradient(to right, #ffffff, #a3a3a3);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .date-badge {
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--color-accent);
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.2);
      padding: 0.5rem 1rem;
      border-radius: 30px;
      box-shadow: 0 0 10px rgba(59, 130, 246, 0.15);
    }

    /* ----------------------------------------------------------------------
       Grid & Metric Cards
       ---------------------------------------------------------------------- */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .card {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      padding: 1.75rem;
      box-shadow: var(--glass-glow);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      position: relative;
      overflow: hidden;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 15px rgba(255, 255, 255, 0.02);
      border-color: rgba(255, 255, 255, 0.12);
    }

    .card-confirmed::before { background: var(--color-danger); }
    .card-sessions::before { background: var(--color-warning); }
    .card-unconfirmed::before { background: var(--color-accent); }

    .card-title {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      margin-bottom: 0.75rem;
      font-weight: 600;
    }

    .card-value {
      font-size: 2.5rem;
      font-weight: 700;
      letter-spacing: -1px;
      margin-bottom: 0.25rem;
      display: flex;
      align-items: baseline;
      gap: 4px;
    }

    .card-value span {
      font-size: 1.25rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .card-confirmed .card-value {
      color: var(--color-danger);
      text-shadow: 0 0 15px rgba(244, 67, 54, 0.25);
    }

    .card-description {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* ----------------------------------------------------------------------
       Visualizations & Layout sections
       ---------------------------------------------------------------------- */
    .dashboard-layout {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    @media (max-width: 968px) {
      .dashboard-layout {
        grid-template-columns: 1fr;
      }
    }

    .section-container {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: 24px;
      padding: 2rem;
      box-shadow: var(--glass-glow);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .section-title {
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      letter-spacing: -0.2px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: 0.75rem;
    }

    .chart-wrapper {
      position: relative;
      height: 280px;
      width: 100%;
    }

    /* ----------------------------------------------------------------------
       Ranked List / Sites Section
       ---------------------------------------------------------------------- */
    .site-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .site-row {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .site-info {
      display: flex;
      justify-content: space-between;
      font-size: 0.9rem;
    }

    .site-name {
      font-weight: 500;
      color: var(--text-main);
    }

    .site-time {
      color: var(--color-danger);
      font-weight: 600;
    }

    .progress-bar-bg {
      background: rgba(255, 255, 255, 0.05);
      height: 8px;
      border-radius: 10px;
      overflow: hidden;
    }

    .progress-bar-fill {
      background: linear-gradient(90deg, var(--color-danger) 0%, #d32f2f 100%);
      height: 100%;
      border-radius: 10px;
      box-shadow: 0 0 8px rgba(211, 47, 47, 0.4);
    }

    /* ----------------------------------------------------------------------
       Chronological Session Logs
       ---------------------------------------------------------------------- */
    .logs-container {
      margin-top: 1.5rem;
    }

    .log-table-wrapper {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.9rem;
    }

    th, td {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    th {
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 1px;
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background: rgba(255, 255, 255, 0.01);
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge-confirmed {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.25);
      color: #fc8181;
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.1);
    }

    .badge-unconfirmed {
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.25);
      color: #fbd38d;
    }

    .badge-gaze {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--glass-border);
      color: var(--text-muted);
    }

    .no-data {
      text-align: center;
      padding: 3rem;
      color: var(--text-muted);
      font-size: 0.95rem;
    }
  </style>
</head>
<body>

<div class="container">
  
  <!-- Header Banner -->
  <header>
    <div class="branding">
      <div class="logo-mark"></div>
      <h1>FocusGuard Daily Digest</h1>
    </div>
    <div class="date-badge">{{ date }}</div>
  </header>

  <!-- Metric Summary Cards -->
  <div class="metrics-grid">
    <div class="card card-confirmed">
      <div class="card-title">Confirmed Doomscrolling</div>
      <div class="card-value">{{ confirmed_duration_mins }} <span>mins</span></div>
      <div class="card-description">Hands idle & visually focused on distracting tabs</div>
    </div>
    
    <div class="card card-sessions">
      <div class="card-title font-bold">Total Confirmed Sessions</div>
      <div class="card-value">{{ confirmed_count }} <span>sessions</span></div>
      <div class="card-description">Long-form focused distractions detected</div>
    </div>

    <div class="card card-unconfirmed">
      <div class="card-title">Unconfirmed (Near Misses)</div>
      <div class="card-value">{{ unconfirmed_duration_mins }} <span>mins</span></div>
      <div class="card-description">Hands idle on distracting apps but user looked away</div>
    </div>
  </div>

  <!-- Dashboard Main Layout -->
  <div class="dashboard-layout">
    
    <!-- Left: Hourly Distraction Heatmap -->
    <div class="section-container">
      <div class="section-title">
        <span>Distraction Distribution By Hour</span>
        <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: normal;">(Minutes spent doomscrolling)</span>
      </div>
      <div class="chart-wrapper">
        <canvas id="hourlyChart"></canvas>
      </div>
    </div>

    <!-- Right: Ranked Top Distractions -->
    <div class="section-container">
      <div class="section-title">Top Distracting Sources</div>
      {% if top_sites %}
        <div class="site-list">
          {% set max_dur = top_sites[0].duration_mins if top_sites else 1.0 %}
          {% for site in top_sites %}
            {% set pct = (site.duration_mins / max_dur) * 100 if max_dur > 0 else 0 %}
            <div class="site-row">
              <div class="site-info">
                <span class="site-name">{{ site.site }}</span>
                <span class="site-time">{{ site.duration_mins }}m</span>
              </div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" style="width: {{ pct }}%;"></div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="no-data">No distracting sites or apps logged today.</div>
      {% endif %}
    </div>

  </div>

  <!-- Row 2: Past 7 Days Trendline -->
  <div class="section-container" style="margin-bottom: 2rem;">
    <div class="section-title">Weekly Distraction Trend (Last 7 Days)</div>
    <div class="chart-wrapper" style="height: 250px;">
      <canvas id="weeklyChart"></canvas>
    </div>
  </div>

  <!-- Chronological Table Logs -->
  <div class="section-container">
    <div class="section-title">Chronological Log of Distractions</div>
    {% if sessions %}
      <div class="log-table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Start Time</th>
              <th>Source Domain / Application</th>
              <th>Window App</th>
              <th>Duration</th>
              <th>Detection Tier</th>
              <th>Gaze Signal</th>
            </tr>
          </thead>
          <tbody>
            {% for session in sessions %}
              <tr>
                <td style="font-weight: 500; color: var(--text-main);">{{ session.time }}</td>
                <td style="font-family: monospace; font-size: 0.85rem; color: var(--color-accent);">{{ session.site }}</td>
                <td>{{ session.app_name }}</td>
                <td>{{ session.duration_mins }}m</td>
                <td>
                  {% if session.tier == 'confirmed' %}
                    <span class="badge badge-confirmed">Confirmed</span>
                  {% else %}
                    <span class="badge badge-unconfirmed">Unconfirmed</span>
                  {% endif %}
                </td>
                <td>
                  <span class="badge badge-gaze">{{ session.gaze_status }}</span>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <div class="no-data" style="padding: 4rem;">
        <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">🎉 Fully Focused!</div>
        No distracting sessions recorded today. Keep up the deep work!
      </div>
    {% endif %}
  </div>

</div>

<!-- ----------------------------------------------------------------------
     Interactive Chart rendering (Offline Chart.js Initialization)
     ---------------------------------------------------------------------- -->
<script>
  // Chart.js global configuration overrides for premium dark-mode styling
  Chart.defaults.color = '#9ca3af';
  Chart.defaults.font.family = "'Inter', sans-serif";

  // Data from Jinja2
  const hourlyData = {{ hourly_buckets | tojson }};
  const weeklyRaw = {{ weekly_trend | tojson }};

  // 1. Hourly Heatmap Chart
  const ctxHourly = document.getElementById('hourlyChart').getContext('2d');
  
  // Hours labels: ["12 AM", "1 AM", ... "11 PM"]
  const hourLabels = Array.from({ length: 24 }, (_, i) => {
    const ampm = i >= 12 ? 'PM' : 'AM';
    const displayHour = i % 12 === 0 ? 12 : i % 12;
    return `${displayHour} ${ampm}`;
  });

  const hourlyChart = new Chart(ctxHourly, {
    type: 'bar',
    data: {
      labels: hourLabels,
      datasets: [{
        label: 'Minutes Doomscrolling',
        data: hourlyData,
        backgroundColor: 'rgba(239, 68, 68, 0.4)',
        borderColor: 'rgba(239, 68, 68, 0.85)',
        borderWidth: 1.5,
        borderRadius: 4,
        hoverBackgroundColor: 'rgba(239, 68, 68, 0.75)',
        hoverBorderColor: '#ef4444'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        x: {
          grid: { display: false }
        },
        y: {
          beginAtZero: true,
          grid: { color: 'rgba(255, 255, 255, 0.05)' },
          title: { display: true, text: 'Minutes' }
        }
      }
    }
  });

  // 2. Weekly Trend Line Chart
  const ctxWeekly = document.getElementById('weeklyChart').getContext('2d');
  
  // Format labels from "YYYY-MM-DD" to "MMM DD" (e.g. "Jun 01")
  const weeklyLabels = weeklyRaw.map(item => {
    try {
      const parts = item.date.split('-');
      const d = new Date(parts[0], parts[1] - 1, parts[2]);
      return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    } catch {
      return item.date;
    }
  });
  const weeklyValues = weeklyRaw.map(item => item.confirmed_duration_mins);

  const weeklyChart = new Chart(ctxWeekly, {
    type: 'line',
    data: {
      labels: weeklyLabels,
      datasets: [{
        label: 'Doomscrolling Time',
        data: weeklyValues,
        borderColor: 'rgba(59, 130, 246, 0.85)',
        backgroundColor: 'rgba(59, 130, 246, 0.08)',
        fill: true,
        tension: 0.35,
        borderWidth: 3,
        pointBackgroundColor: '#3b82f6',
        pointBorderColor: '#ffffff',
        pointBorderWidth: 2,
        pointRadius: 5,
        pointHoverRadius: 7
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        x: {
          grid: { display: false }
        },
        y: {
          beginAtZero: true,
          grid: { color: 'rgba(255, 255, 255, 0.05)' },
          title: { display: true, text: 'Minutes' }
        }
      }
    }
  });
</script>

</body>
</html>
